---
import Layout from '../layouts/Layout.astro';
import Directory from '../components/Directory.astro';
import FilterMenu from '../components/FilterMenu.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import { HOME, PARTNERS } from '../data/people';
---

<Layout title={`${HOME.title} — ARDI`} description={HOME.subtitle}>
  <Header />
  <Hero />
  <Directory />
  {/* Left out until a partner is published, along with its jump link (JUMP_LINKS). */}
  {PARTNERS.length > 0 && <Partners />}
  <Footer />
  <FilterMenu />
</Layout>

<script>
  import '../scripts/directory';
</script>
