---
import Logo from './Logo.astro';
---

<footer class="bg-ardi-ink text-ardi-paper">
  <div class="mx-auto max-w-[1800px] px-4 pt-9 pb-4 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-5 border-t border-white/30 pt-[26px] pb-1">
      <a href="https://ardi.ro" target="_blank" rel="noopener" aria-label="ARDI — Romanian Association for Design and Innovation" class="block text-ardi-paper">
        <Logo variant="lockup" class="h-[38px] w-[76px] md:h-11 md:w-[87px]" />
      </a>
      <span class="text-[13px] leading-normal tracking-[.01em] text-ardi-stone uppercase">
        Realizat de <a href="https://vicusbass.com" target="_blank" rel="noopener" class="border-b border-white/60 text-ardi-paper">vicusbass.com</a>
      </span>
    </div>
  </div>
</footer>
