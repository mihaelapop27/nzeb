---
import { CURATORS, JUMP_LINKS, PEOPLE } from '../data/people';
import { profilesLabel } from '../data/labels';
import PersonCard from './PersonCard.astro';
import PersonRow from './PersonRow.astro';

const subhead = 'max-w-[560px] font-subhead text-[clamp(19px,1.7vw,26px)] leading-subhead font-semibold tracking-subhead text-pretty text-ardi-black';
---

<section class="mx-auto max-w-[1800px] px-4 pt-[72px] pb-11 md:px-10">
  <div data-hero-reveal class="text-[11px] tracking-[.14em] text-ardi-slate uppercase">Conferință de Design</div>
  <h1 data-hero-reveal style="--i: 1" class="mt-[18px] mb-[22px] font-title text-[clamp(46px,6.4vw,104px)] leading-none font-black tracking-title text-balance uppercase md:leading-title">
    Arhitecți <em>&amp;</em> Designeri
  </h1>
  <p data-hero-reveal style="--i: 2" class:list={[subhead, 'm-0']}>Oamenii care dau formă spațiilor în care ne adunăm.</p>

  <div data-results-top class="relative mt-12">
    <div class="flex flex-wrap justify-between gap-1.5 md:justify-end md:gap-x-7 md:gap-y-2.5">
      {
        JUMP_LINKS.map((j) => (
          <a
            href={`#${j.id}`}
            data-jump={j.id}
            class="inline-flex items-center gap-0 border border-ardi-stone px-1.5 py-1.5 text-[11px] font-bold tracking-[.1em] whitespace-nowrap text-ardi-blue uppercase md:gap-[7px] md:border-0 md:p-0 md:text-[12px] md:tracking-[.14em] aria-disabled:pointer-events-none aria-disabled:text-ardi-muted"
          >
            {j.label}
          </a>
        ))
      }
    </div>
    <div data-reset-row hidden class="absolute right-0 bottom-full mb-3.5 flex justify-end text-[11px] tracking-[.12em] text-ardi-slate uppercase">
      <button
        type="button"
        data-reset
        class="inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent p-0 font-[inherit] tracking-[inherit] text-ardi-blue uppercase"
      >
        <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7"></path></svg>
        <span data-reset-label>Resetează filtrele</span>
      </button>
    </div>
  </div>

  <div class="mt-3.5 md:mt-1.5">
    <div id="curatori" data-curators>
      <div class="border-t border-ardi-stone pt-3.5">
        <div class="flex items-baseline justify-between gap-4 whitespace-nowrap">
          <span class="text-[11px] font-bold tracking-[.14em] text-ardi-blue uppercase">Curatori</span>
          <span data-curators-count class="text-[11px] tracking-[.12em] text-ardi-slate uppercase">{profilesLabel(CURATORS.length)}</span>
        </div>
        <p class:list={[subhead, 'mt-[18px] mb-0']}>Oamenii care întrețin și verifică informațiile publicate pe acest site.</p>
      </div>
      <div data-curators-view="cards" class="mt-11 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-x-7 md:gap-y-14 xl:grid-cols-4 2xl:grid-cols-5">
        {CURATORS.map((p) => <PersonCard person={p} curator />)}
      </div>
      <div data-curators-view="list" hidden class="mt-7">
        {CURATORS.map((p) => <PersonRow person={p} curator />)}
      </div>
    </div>
  </div>

  <!-- With no curators shown, this line sits right under the jump links, like the curators line would. -->
  <div
    id="arhitecti"
    class="mt-10 flex justify-between gap-4 border-t border-ardi-stone pt-3.5 text-[11px] tracking-[.12em] whitespace-nowrap text-ardi-slate uppercase md:mt-[60px] [:has(>[data-curators][hidden])+&]:mt-0"
  >
    <span class="text-[11px] font-bold tracking-[.14em] text-ardi-blue uppercase">Arhitecți & Designeri</span>
    <span data-count>{profilesLabel(PEOPLE.length)}</span>
  </div>
</section>
