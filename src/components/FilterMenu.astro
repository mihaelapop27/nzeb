---
import { CATEGORIES, CITIES, PEOPLE } from '../data/people';
import { showProfilesLabel } from '../data/labels';
import Logo from './Logo.astro';

const heading = 'text-[10.5px] tracking-[.14em] text-ardi-slate uppercase';
const chip = 'border border-ardi-stone bg-transparent px-2 py-[11px] text-center whitespace-nowrap text-chip transition-colors duration-200 aria-pressed:bg-chip aria-pressed:text-chip-fg';
---

<div data-menu hidden class="fixed inset-0 z-40 flex flex-col overflow-auto bg-ardi-paper">
  <div class="flex h-16 flex-none items-center justify-between border-b border-ardi-stone px-4 md:px-10">
    <span aria-label="ARDI" class="inline-flex items-center leading-none text-ardi-black">
      <Logo variant="mark" class="h-5 w-[74px] lg:h-6 lg:w-[88px]" />
    </span>
    <button type="button" data-menu-close aria-label="Închide" class="-mr-2.5 grid size-9 place-items-center border-0 bg-transparent">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 4l10 10M14 4 4 14"></path></svg>
    </button>
  </div>
  <div class="flex flex-1 flex-col gap-9 px-6 pt-8 pb-6">
    <div class="flex flex-col gap-3.5">
      <div class="flex items-baseline justify-between gap-4">
        <div class={heading}>Categorie</div>
        <button
          type="button"
          data-menu-reset
          hidden
          class="inline-flex items-center gap-1.5 border-0 bg-transparent p-0 text-[11px] tracking-[.12em] text-ardi-blue uppercase"
        >
          <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7"></path></svg>
          <span data-menu-reset-label>Resetează filtrele</span>
        </button>
      </div>
      <div class="grid grid-cols-3 gap-2">
        {
          CATEGORIES.map((c) => (
            <button type="button" data-cat={c.value} aria-pressed={c.value === 'all' ? 'true' : 'false'} class:list={[chip, 'text-[12px] tracking-[.08em] uppercase']}>
              {c.longLabel}
            </button>
          ))
        }
      </div>
    </div>
    <div class="flex flex-col gap-3.5">
      <div class={heading}>Oraș</div>
      <div class="grid grid-cols-3 gap-2">
        {
          ['all', ...CITIES].map((city) => (
            <button type="button" data-city={city} aria-pressed={city === 'all' ? 'true' : 'false'} class:list={[chip, 'text-[13px]']}>
              {city === 'all' ? 'Toate orașele' : city}
            </button>
          ))
        }
      </div>
    </div>
    <button
      type="button"
      data-menu-close
      data-show-label
      class="mt-auto border-0 bg-ardi-black px-6 py-4 text-[12px] tracking-[.12em] text-ardi-paper uppercase"
    >
      {showProfilesLabel(PEOPLE.length)}
    </button>
  </div>
</div>
