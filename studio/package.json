{
  "name": "nzeb-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "seed": "sanity exec seed/import.ts --with-user-token",
    "import-tally": "sanity exec scripts/import-tally.ts --with-user-token --",
    "export-pdf": "sanity exec scripts/export-pdf.ts --with-user-token --",
    "typegen": "sanity schemas extract --force && sanity typegen generate"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@sanity/image-url": "^2.1.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
